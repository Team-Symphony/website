---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeartIcon from "../assets/heart.svg";
import "../styles/global.css";
// To import simple-icons-astro go to this site:
// https://simple-icons-astro.dzeio.com/
// and put the name for the icon shown there after "simple-icons-astro/"
// Be careful with autocomplete! It will betray you and import ALL ICONS which will make the page reaaaaaaally slow so don't use that plz thx
import ModrinthIcon from "simple-icons-astro/Modrinth";
import DiscordIcon from "simple-icons-astro/Discord";
import GithubIcon from "simple-icons-astro/Github";
---

<BaseLayout>
  <div class="grid min-h-screen grid-cols-3 grid-rows-3">
    <!-- Title -->
    <div class="col-start-2 row-start-1 flex items-center justify-center">
      <h1 class="text-4xl font-bold text-white">Team Symphony</h1>
    </div>

    <!-- Text and heart -->
    <div class="row-start-2 flex items-center justify-center">
      <p class="text-center text-white">Lorem ipsum dolor sit amet.</p>
    </div>
    <div class="row-start-2 flex items-center justify-center">
      <HeartIcon size={150} overflow="visible" />
    </div>
    <div class="row-start-2 flex items-center justify-center">
      <p class="text-center text-white">Lorem ipsum dolor sit amet.</p>
    </div>

    <!-- Socials dock -->
    <div
      class="col-start-2 row-start-3 flex h-fit w-fit items-center justify-center justify-self-center rounded-[2rem] bg-black/30 p-4 backdrop-blur-md"
    >
      <a href="https://modrinth.com/team/symphony" class="group">
        <div
          class="m-2 rounded-xl bg-black/80 p-3 transition-all duration-300 hover:scale-110 hover:bg-black"
        >
          <ModrinthIcon
            class="h-6 w-6 text-white transition-colors duration-300 group-hover:text-[#00AF5C]"
          />
        </div>
      </a>
      <a href="https://discord.gg/your-invite" class="group">
        <div
          class="m-2 rounded-xl bg-black/80 p-3 transition-all duration-300 hover:scale-110 hover:bg-black"
        >
          <DiscordIcon
            class="h-6 w-6 text-white transition-colors duration-300 group-hover:text-[#5865F2]"
          />
        </div>
      </a>
      <a href="https://github.com/Team-Symphony" class="group">
        <div
          class="m-2 rounded-xl bg-black/80 p-3 transition-all duration-300 hover:scale-110 hover:bg-black"
        >
          <GithubIcon
            class="h-6 w-6 text-white transition-colors duration-300 group-hover:text-white/80"
          />
        </div>
      </a>
    </div>

    <!-- Background -->
    <div id="background-overlay"></div>
    <div id="antialasing"></div>
    <div id="background"></div>
  </div>
</BaseLayout>

<style>
  #background-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backdrop-filter: brightness(50%) blur(10px);
    -webkit-backdrop-filter: blur(10px);
    mask-image: radial-gradient(
      circle at center,
      transparent 80px,
      black 100px
    );
    -webkit-mask-image: radial-gradient(
      circle at center,
      transparent 80px,
      black 100px
    );
    z-index: -98;
  }
  #antialasing {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backdrop-filter: blur(1px);
    -webkit-backdrop-filter: blur(1px);
    z-index: -99;
  }
  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -100;
    background: conic-gradient(
      from 0deg at 50% 50%,
      #ef233c 1deg,
      #ef233c 60deg,
      #fc7531 60deg,
      #fc7531 120deg,
      #fcc331 120deg,
      #fcc331 180deg,
      #2cc04a 180deg,
      #2cc04a 240deg,
      #3f48cc 240deg,
      #3f48cc 300deg,
      #6f1798 300deg,
      #6f1798 360deg
    );
  }
</style>
